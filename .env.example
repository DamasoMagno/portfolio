# Persistência: supabase em produção; local é permitido somente em desenvolvimento/testes.
PORTFOLIO_STORAGE=supabase
SUPABASE_URL=
# Opcionais, caso futuramente use recursos públicos no navegador.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chave secreta sb_secret_... (somente servidor; nunca NEXT_PUBLIC).
SUPABASE_SECRET_KEY=
# Opcional: chave service_role legada, caso o projeto ainda a utilize.
SUPABASE_SERVICE_ROLE_KEY=

# Login obrigatório do proprietário. O Supabase armazena dados; o login existente é mantido.
BACKOFFICE_ADMIN_EMAIL=bridamo.pt@gmail.com
BACKOFFICE_PASSWORD=
BACKOFFICE_SESSION_SECRET=
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
ANALYTICS_ENABLED=true

# Arquivos locais usados no desenvolvimento ou como origem para supabase:import.
PORTFOLIO_DATA_FILE=
PORTFOLIO_ANALYTICS_FILE=
PORTFOLIO_POSTS_FILE=

# Somente para supabase:setup via psql. A aplicação não usa a senha do Postgres.
SUPABASE_DB_PASSWORD=
SUPABASE_DB_HOST=
SUPABASE_DB_USER=
SUPABASE_DB_PORT=

# Imagens via S3 do Supabase; todas estas credenciais são exclusivas do servidor.
S3_ENDPOINT=
S3_REGION=sa-east-1
S3_BUCKET=images
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# URL pública estável do bucket, que deve ser público.
S3_PUBLIC_BASE_URL=
